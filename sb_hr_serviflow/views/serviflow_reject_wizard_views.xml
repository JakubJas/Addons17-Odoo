<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_serviflow_reject_wizard_form" model="ir.ui.view">
        <field name="name">serviflow.reject.wizard.form</field>
        <field name="model">serviflow.reject.wizard</field>

        <field name="arch" type="xml">
            <form string="Rechazar presupuesto">

                <group>
                    <field name="task_id" invisible="1"/>

                    <field name="rejection_reason"
                           placeholder="Indica qué debe corregir el técnico..."/>
                </group>

                <footer>
                    <button name="action_confirm_reject"
                            string="Confirmar rechazo"
                            type="object"
                            class="btn-danger"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>