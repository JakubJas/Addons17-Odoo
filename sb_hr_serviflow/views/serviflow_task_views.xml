<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_serviflow_task_tree" model="ir.ui.view">
        <field name="name">serviflow.task.tree</field>
        <field name="model">serviflow.task</field>
        <field name="arch" type="xml">
            <tree string="Solicitudes Serviflow">
                <field name="name"/>
                <field name="opportunity_id"/>
                <field name="project_id"/>
                <field name="project_task_id"/>
                <field name="sale_order_id"/>
                <field name="task_type"/>
                <field name="state"/>
                <field name="review_result"/>
                <field name="review_round"/>
                <field name="assigned_user_id"/>
                <field name="accepted_user_id"/>
                <field name="requested_by_user_id"/>
                <field name="requested_at"/>
                <field name="accepted_at"/>
                <field name="completed_at"/>
                <field name="reviewed_at"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_serviflow_task_form" model="ir.ui.view">
        <field name="name">serviflow.task.form</field>
        <field name="model">serviflow.task</field>
        <field name="arch" type="xml">
            <form string="Solicitud Serviflow">
                <header>
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>

                    <button name="action_reassign"
                            string="Reasignar"
                            type="object"
                            class="btn-secondary"
                            groups="sb_hr_serviflow.group_serviflow_manager"
                            invisible="state in ('done', 'cancelled') or task_type != 'budget'"/>

                    <button name="action_review_approve"
                            string="Aprobar"
                            type="object"
                            class="btn-success"
                            invisible="task_type != 'review' or review_result != 'pending' or assigned_user_id != uid"/>

                    <button name="action_open_reject_wizard"
                            string="Rechazar"
                            type="object"
                            class="btn-danger"
                            invisible="task_type != 'review' or review_result != 'pending' or assigned_user_id != uid"/>

                    <field name="state" widget="statusbar" readonly="1"/>
                </header>

                <sheet>
                    <group string="Datos principales">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="task_type" readonly="1"/>
                            <field name="opportunity_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="project_task_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="assigned_user_id" readonly="1"/>
                            <field name="accepted_user_id" readonly="1"/>
                            <field name="review_result"
                                   readonly="1"
                                   invisible="task_type != 'review'"/>
                            <field name="review_round"
                                   readonly="1"
                                   invisible="task_type != 'review'"/>
                        </group>
                    </group>

                    <group string="Reasignacion"
                           groups="sb_hr_serviflow.group_serviflow_manager"
                           invisible="task_type != 'budget' or state in ('done', 'cancelled')">
                        <field name="reassign_user_id"/>
                    </group>

                    <group string="Datos de la solicitud"
                           invisible="task_type != 'budget'">
                        <field name="note"
                               string="Indicaciones para Oficina Tecnica"
                               readonly="1"
                               placeholder="Sin indicaciones adicionales..."/>
                    </group>

                    <group string="Informacion de rechazo"
                           invisible="task_type != 'review' or review_result != 'rejected'">
                        <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </group>

                    <group string="Trazabilidad">
                        <group>
                            <field name="requested_by_user_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                            <field name="accepted_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="completed_at" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                            <field name="final_approved_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_serviflow_task_search" model="ir.ui.view">
        <field name="name">serviflow.task.search</field>
        <field name="model">serviflow.task</field>
        <field name="arch" type="xml">
            <search string="Buscar solicitudes">
                <field name="name"/>
                <field name="opportunity_id"/>
                <field name="project_id"/>
                <field name="project_task_id"/>
                <field name="sale_order_id"/>
                <field name="assigned_user_id"/>
                <field name="requested_by_user_id"/>

                <filter name="pending"
                        string="Pendientes"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="accepted"
                        string="Aceptadas"
                        domain="[('state', '=', 'accepted')]"/>
                <filter name="reviews_pending"
                        string="Pendientes de revision"
                        domain="[('task_type', '=', 'review'), ('review_result', '=', 'pending')]"/>
                <filter name="approved_reviews"
                        string="Revisiones aprobadas"
                        domain="[('task_type', '=', 'review'), ('review_result', '=', 'approved')]"/>
                <filter name="rejected_reviews"
                        string="Rechazadas"
                        domain="[('task_type', '=', 'review'), ('review_result', '=', 'rejected')]"/>
                <filter name="done"
                        string="Completadas"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="my_tasks"
                        string="Mis tareas"
                        domain="[('assigned_user_id', '=', uid)]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_task_type"
                            string="Tipo"
                            context="{'group_by': 'task_type'}"/>
                    <filter name="group_state"
                            string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_review_result"
                            string="Resultado revision"
                            context="{'group_by': 'review_result'}"/>
                    <filter name="group_assigned_user"
                            string="Usuario asignado"
                            context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_requested_by"
                            string="Solicitado por"
                            context="{'group_by': 'requested_by_user_id'}"/>
                    <filter name="group_review_round"
                            string="Ronda"
                            context="{'group_by': 'review_round'}"/>
                    <filter name="group_project"
                            string="Proyecto"
                            context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_serviflow_task_manager" model="ir.actions.act_window">
        <field name="name">Todas las Solicitudes</field>
        <field name="res_model">serviflow.task</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_serviflow_task_search"/>
    </record>

    <!-- Los tecnicos no trabajan dentro de Serviflow. Mantienen ACL de modelo
         porque el systray necesita leer/aceptar solicitudes, pero no tienen menu. -->
    <menuitem id="menu_serviflow_root"
              name="Serviflow"
              sequence="20"
              groups="sb_hr_serviflow.group_serviflow_manager"
              web_icon="SB-Addons17,sb_hr_serviflow/static/description/icon.png"/>

    <menuitem id="menu_serviflow_tasks_manager"
              name="Todas las Solicitudes"
              parent="menu_serviflow_root"
              action="action_serviflow_task_manager"
              sequence="20"
              groups="sb_hr_serviflow.group_serviflow_manager"/>

</odoo>
