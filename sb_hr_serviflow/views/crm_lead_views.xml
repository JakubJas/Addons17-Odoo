<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_form_serviflow" model="ir.ui.view">
        <field name="name">crm.lead.form.serviflow</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <field name="is_serviflow_budget_requested"
                       invisible="1"/>

                <button name="action_open_serviflow_budget_wizard"
                        string="Solicitar PPTO Técnico"
                        type="object"
                        class="btn-primary"
                        invisible="is_serviflow_budget_requested"/>

            </xpath>

        </field>
    </record>

</odoo>