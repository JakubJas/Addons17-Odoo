<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_serviflow_request_budget_wizard_form"
            model="ir.ui.view">

        <field name="name">
            serviflow.request.budget.wizard.form
        </field>

        <field name="model">
            serviflow.request.budget.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Solicitar Presupuesto Técnico">

                <group>

                    <field name="opportunity_id"/>

                    <field name="technical_notes"
                           placeholder="Indica qué debe presupuestar Oficina Técnica..."/>

                    <field name="priority"/>

                    <field name="requested_date"/>

                </group>

                <footer>

                    <button name="action_confirm"
                            string="Enviar a Oficina Técnica"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>