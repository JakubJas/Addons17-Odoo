<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_form_serviflow" model="ir.ui.view">
        <field name="name">project.task.form.serviflow</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">90</field>

        <field name="arch" type="xml">

            <!-- ================================================= -->
            <!-- CAMPOS TÉCNICOS -->
            <!-- ================================================= -->

            <xpath expr="//sheet" position="inside">
                <field name="is_serviflow_budget_task" invisible="1"/>
                <field name="serviflow_opportunity_id" invisible="1"/>
                <field name="serviflow_sale_order_count" invisible="1"/>
                <field name="serviflow_has_rejection" invisible="1"/>
            </xpath>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <xpath expr="//header" position="inside">

                <button name="action_serviflow_create_quotation"
                        string="Crear presupuesto"
                        type="object"
                        class="btn-primary"
                        icon="fa-plus"
                        invisible="not is_serviflow_budget_task"/>

                <button name="action_serviflow_open_quotations"
                        string="Abrir presupuestos"
                        type="object"
                        class="btn-secondary"
                        icon="fa-folder-open"
                        invisible="not is_serviflow_budget_task or serviflow_sale_order_count == 0"/>

            </xpath>


            <!-- ================================================= -->
            <!-- SELECTOR MÚLTIPLE DE PRESUPUESTOS -->
            <!-- ================================================= -->

            <xpath expr="//field[@name='user_ids']" position="after">

                <field name="serviflow_sale_order_ids"
                       string="Presupuestos asociados"
                       widget="many2many_tags"
                       domain="[('opportunity_id', '=', serviflow_opportunity_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"
                       invisible="not is_serviflow_budget_task"/>

            </xpath>


            <!-- ================================================= -->
            <!-- BLOQUE SERVIFLOW -->
            <!-- Lo insertamos justo antes del notebook -->
            <!-- ================================================= -->

            <xpath expr="//notebook" position="before">

                <group string="Serviflow / Presupuesto técnico"
                       invisible="not is_serviflow_budget_task">

                    <group>

                        <field name="serviflow_opportunity_id"
                               string="Oportunidad"
                               readonly="1"/>

                        <field name="serviflow_priority_label"
                               string="Prioridad"
                               readonly="1"/>

                        <field name="serviflow_requested_date_label"
                               string="Fecha deseada"
                               readonly="1"/>

                        <field name="serviflow_current_round"
                               string="Ronda actual"
                               readonly="1"/>

                    </group>

                    <group>

                        <field name="serviflow_request_note"
                               string="Indicaciones"
                               readonly="1"/>

                    </group>

                </group>


                <!-- ============================================= -->
                <!-- ÚLTIMO RECHAZO -->
                <!-- ============================================= -->

                <group string="Corrección pendiente"
                       invisible="not is_serviflow_budget_task or not serviflow_has_rejection">

                    <field name="serviflow_last_rejection_reason"
                           string="Motivo del último rechazo"
                           readonly="1"
                           nolabel="1"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>