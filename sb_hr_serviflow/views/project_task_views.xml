<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_form_serviflow" model="ir.ui.view">
        <field name="name">project.task.form.serviflow</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>

        <field name="arch" type="xml">

            <!-- Campos técnicos para controlar visibilidad -->
            <xpath expr="//form/sheet" position="before">
                <field name="is_serviflow_budget_task" invisible="1"/>
                <field name="serviflow_sale_order_id" invisible="1"/>
            </xpath>

            <!-- Botón -->
            <xpath expr="//form/header" position="inside">

                <button name="action_serviflow_create_quotation"
                        string="Crear presupuesto"
                        type="object"
                        class="btn-primary"
                        invisible="not is_serviflow_budget_task or serviflow_sale_order_id"/>

                <button name="action_serviflow_create_quotation"
                        string="Abrir presupuesto"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_serviflow_budget_task or not serviflow_sale_order_id"/>

            </xpath>

        </field>
    </record>

</odoo>