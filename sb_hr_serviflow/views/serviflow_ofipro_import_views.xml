<odoo>

    <record
        id="view_serviflow_ofipro_import_form"
        model="ir.ui.view"
    >

        <field name="name">serviflow.ofipro.import.wizard.form</field>
        <field name="model">serviflow.ofipro.import.wizard</field>

        <field name="arch" type="xml">

            <form string="Validar proyectos OfiPro (CSV)">

                <header>

                    <button
                        name="action_validate"
                        string="Analizar CSV"
                        type="object"
                        class="btn-primary"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated"
                    />

                </header>

                <sheet>

                    <group>

                        <field
                            name="file"
                            filename="filename"
                            widget="binary"
                        />

                        <field
                            name="filename"
                            invisible="1"
                        />

                    </group>

                    <div
                        class="alert alert-info"
                        role="alert"
                    >
                        Selecciona un archivo CSV exportado
                        desde OfiPro. Esta fase solo analiza
                        los datos. No crea ni modifica
                        proyectos ni clientes.
                    </div>

                    <group invisible="state != 'validated'">

                        <field
                            name="summary"
                            widget="html"
                            readonly="1"
                            nolabel="1"
                        />

                    </group>

                    <notebook invisible="state != 'validated'">

                        <page string="Vista previa de proyectos">

                            <group>

                                <group>
                                    <field
                                        name="page"
                                        readonly="1"
                                    />

                                    <field
                                        name="total_pages"
                                        readonly="1"
                                    />
                                </group>

                                <group>
                                    <field
                                        name="total_rows"
                                        readonly="1"
                                    />
                                </group>

                            </group>

                            <group>

                                <button
                                    name="action_previous_page"
                                    string="Anterior"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="page &lt;= 1"
                                />

                                <button
                                    name="action_next_page"
                                    string="Siguiente"
                                    type="object"
                                    class="btn-primary"
                                    invisible="page &gt;= total_pages"
                                />

                            </group>

                            <field
                                name="preview"
                                readonly="1"
                                nolabel="1"
                            />

                            <field
                                name="preview_data"
                                invisible="1"
                            />

                        </page>

                        <page string="Incidencias (100)">

                            <field
                                name="issues"
                                readonly="1"
                                nolabel="1"
                            />

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <record
        id="action_serviflow_ofipro_import"
        model="ir.actions.act_window"
    >

        <field name="name">Importar proyectos OfiPro</field>

        <field name="res_model">serviflow.ofipro.import.wizard</field>

        <field name="view_mode">form</field>

        <field
            name="view_id"
            ref="view_serviflow_ofipro_import_form"
        />

        <field name="target">current</field>

    </record>


    <menuitem
        id="menu_serviflow_ofipro_import"
        name="Importar proyectos OfiPro"
        parent="menu_serviflow_root"
        action="action_serviflow_ofipro_import"
        sequence="40"
        groups="sb_hr_serviflow.group_serviflow_manager"
    />

</odoo>
