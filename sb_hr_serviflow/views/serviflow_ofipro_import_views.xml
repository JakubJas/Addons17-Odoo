
<odoo>

    <!-- ================================================ -->
    <!-- VISTA DEL IMPORTADOR OFIPRO                      -->
    <!-- ================================================ -->

    <record
        id="view_serviflow_ofipro_import_form"
        model="ir.ui.view"
    >

        <field name="name">serviflow.ofipro.import.wizard.form</field>

        <field name="model">serviflow.ofipro.import.wizard</field>

        <field name="arch" type="xml">

            <form string="Importar proyectos historicos OfiPro">

                <header>

                    <button
                        name="action_validate"
                        string="Analizar CSV"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_import_batch"
                        string="Importar siguientes 100 registros"
                        type="object"
                        class="btn-primary"
                        confirm="Se crearan proyectos reales en Odoo. Los registros sin cliente unico o con errores se omitiran. Continuar?"
                        invisible="state != 'validated' and state != 'importing'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated,importing,done"
                    />

                </header>

                <sheet>

                    <!-- ARCHIVO CSV -->

                    <group>

                        <field
                            name="file"
                            filename="filename"
                            widget="binary"
                            readonly="state != 'draft'"
                        />

                        <field
                            name="filename"
                            invisible="1"
                        />

                    </group>

                    <!-- INFORMACION -->

                    <div
                        class="alert alert-info"
                        role="alert"
                    >
                        Analiza el CSV antes de importar.
                        La importacion se ejecuta por lotes
                        de 100 registros, omite clientes
                        inexistentes o duplicados y conserva
                        la numeracion historica.

                        Pulsa el boton de importacion hasta
                        que el estado sea Finalizado.
                    </div>

                    <!-- RESUMEN -->

                    <group invisible="state == 'draft'">

                        <field
                            name="summary"
                            widget="html"
                            readonly="1"
                            nolabel="1"
                        />

                    </group>

                    <!-- PESTAÑAS -->

                    <notebook invisible="state == 'draft'">

                        <!-- VISTA PREVIA -->

                        <page string="Vista previa de proyectos">

                            <group>

                                <group>

                                    <field
                                        name="page"
                                        readonly="1"
                                    />

                                    <field
                                        name="total_pages"
                                        readonly="1"
                                    />

                                </group>

                                <group>

                                    <field
                                        name="total_rows"
                                        readonly="1"
                                    />

                                    <field
                                        name="cursor"
                                        readonly="1"
                                    />

                                </group>

                            </group>

                            <!-- PAGINACION -->

                            <group>

                                <button
                                    name="action_previous_page"
                                    string="Anterior"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="page &lt;= 1"
                                />

                                <button
                                    name="action_next_page"
                                    string="Siguiente"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="page &gt;= total_pages"
                                />

                            </group>

                            <field
                                name="preview"
                                readonly="1"
                                nolabel="1"
                            />

                            <field
                                name="preview_data"
                                invisible="1"
                            />

                        </page>

                        <!-- INCIDENCIAS -->

                        <page string="Omisiones e incidencias">

                            <field
                                name="issues"
                                readonly="1"
                                nolabel="1"
                            />

                        </page>

                    </notebook>

                    <!-- CAMPOS INTERNOS -->

                    <field
                        name="import_log"
                        invisible="1"
                    />

                    <field
                        name="imported_count"
                        invisible="1"
                    />

                    <field
                        name="missing_count"
                        invisible="1"
                    />

                    <field
                        name="duplicate_count"
                        invisible="1"
                    />

                    <field
                        name="invalid_count"
                        invisible="1"
                    />

                    <field
                        name="existing_count"
                        invisible="1"
                    />

                    <field
                        name="failed_count"
                        invisible="1"
                    />

                </sheet>

            </form>

        </field>

    </record>


    <!-- ================================================ -->
    <!-- ACCION                                          -->
    <!-- ================================================ -->

    <record
        id="action_serviflow_ofipro_import"
        model="ir.actions.act_window"
    >

        <field name="name">Importar proyectos OfiPro</field>

        <field name="res_model">serviflow.ofipro.import.wizard</field>

        <field name="view_mode">form</field>

        <field
            name="view_id"
            ref="view_serviflow_ofipro_import_form"
        />

        <field name="target">current</field>

    </record>


    <!-- ================================================ -->
    <!-- MENU                                            -->
    <!-- ================================================ -->

    <menuitem
        id="menu_serviflow_ofipro_import"
        name="Importar proyectos OfiPro"
        parent="menu_serviflow_root"
        action="action_serviflow_ofipro_import"
        sequence="40"
        groups="sb_hr_serviflow.group_serviflow_manager"
    />

</odoo>
