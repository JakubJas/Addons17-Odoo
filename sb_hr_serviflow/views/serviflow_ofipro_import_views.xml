
<odoo>

    <!-- IMPORTADOR OFIPRO -->

    <record id="view_serviflow_ofipro_import_form"
            model="ir.ui.view">

        <field name="name">serviflow.ofipro.import.wizard.form</field>
        <field name="model">serviflow.ofipro.import.wizard</field>

        <field name="arch" type="xml">

            <form string="Importar proyectos historicos OfiPro">

                <header>

                    <button
                        name="action_validate"
                        string="Analizar CSV"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_import_batch"
                        string="Importar siguientes 100 registros"
                        type="object"
                        class="btn-primary"
                        confirm="Se crearan proyectos reales en Odoo. Los registros invalidos se omitiran. Continuar?"
                        invisible="state != 'validated' and state != 'importing'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated,importing,done"
                    />

                </header>

                <sheet>

                    <group>

                        <field
                            name="file"
                            filename="filename"
                            widget="binary"
                            readonly="state != 'draft'"
                        />

                        <field
                            name="filename"
                            invisible="1"
                        />

                        <field
                            name="batch_id"
                            readonly="1"
                            invisible="state == 'draft'"
                        />

                    </group>

                    <div class="alert alert-info" role="alert">
                        Analiza el CSV antes de importar.
                        La importacion se realiza por lotes
                        de 100 registros.

                        Los proyectos creados quedan
                        asociados a un lote para permitir
                        su posterior reversion.
                    </div>

                    <group invisible="state == 'draft'">

                        <field
                            name="summary"
                            widget="html"
                            readonly="1"
                            nolabel="1"
                        />

                    </group>

                    <notebook invisible="state == 'draft'">

                        <page string="Vista previa de proyectos">

                            <group>

                                <group>
                                    <field name="page" readonly="1"/>
                                    <field name="total_pages" readonly="1"/>
                                </group>

                                <group>
                                    <field name="total_rows" readonly="1"/>
                                    <field name="cursor" readonly="1"/>
                                </group>

                            </group>

                            <group>

                                <button
                                    name="action_previous_page"
                                    string="Anterior"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="page &lt;= 1"
                                />

                                <button
                                    name="action_next_page"
                                    string="Siguiente"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="page &gt;= total_pages"
                                />

                            </group>

                            <field
                                name="preview"
                                readonly="1"
                                nolabel="1"
                            />

                            <field
                                name="preview_data"
                                invisible="1"
                            />

                        </page>

                        <page string="Omisiones e incidencias">

                            <field
                                name="issues"
                                readonly="1"
                                nolabel="1"
                            />

                        </page>

                    </notebook>

                    <field name="import_log" invisible="1"/>
                    <field name="imported_count" invisible="1"/>
                    <field name="missing_count" invisible="1"/>
                    <field name="duplicate_count" invisible="1"/>
                    <field name="invalid_count" invisible="1"/>
                    <field name="existing_count" invisible="1"/>
                    <field name="failed_count" invisible="1"/>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ACCION DEL IMPORTADOR -->

    <record id="action_serviflow_ofipro_import"
            model="ir.actions.act_window">

        <field name="name">Importar proyectos OfiPro</field>
        <field name="res_model">serviflow.ofipro.import.wizard</field>
        <field name="view_mode">form</field>

        <field
            name="view_id"
            ref="view_serviflow_ofipro_import_form"
        />

        <field name="target">current</field>

    </record>


    <menuitem
        id="menu_serviflow_ofipro_import"
        name="Importar proyectos OfiPro"
        parent="menu_serviflow_root"
        action="action_serviflow_ofipro_import"
        sequence="40"
        groups="sb_hr_serviflow.group_serviflow_manager"
    />


    <!-- LISTADO DE LOTES -->

    <record id="view_serviflow_ofipro_batch_tree"
            model="ir.ui.view">

        <field name="name">serviflow.ofipro.batch.tree</field>
        <field name="model">serviflow.ofipro.batch</field>

        <field name="arch" type="xml">

            <tree
                string="Importaciones OfiPro"
                create="false"
                delete="false">

                <field name="name"/>
                <field name="filename"/>
                <field name="user_id"/>
                <field name="imported_total"/>
                <field name="removed_total"/>
                <field name="project_count"/>
                <field name="state"/>

            </tree>

        </field>

    </record>


    <!-- FORMULARIO DEL LOTE -->

    <record id="view_serviflow_ofipro_batch_form"
            model="ir.ui.view">

        <field name="name">serviflow.ofipro.batch.form</field>
        <field name="model">serviflow.ofipro.batch</field>

        <field name="arch" type="xml">

            <form
                string="Lote de importacion OfiPro"
                create="false"
                delete="false">

                <header>

                    <button
                        name="action_open_projects"
                        string="Ver proyectos"
                        type="object"
                        class="btn-secondary"
                    />

                    
                    <button
                        name="action_rollback"
                        string="Eliminar siguientes 50 proyectos"
                        type="object"
                        class="btn-danger"
                        invisible="state == 'reverted' or project_count == 0"
                        confirm="Se revisaran hasta 50 proyectos del lote y se eliminaran permanentemente los que no tengan relaciones protegidas. Esta accion no se puede deshacer. Continuar?"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="active,partial,reverted"
                    />

                </header>

                <sheet>

                    <group>

                        <field name="name" readonly="1"/>
                        <field name="filename" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="imported_total" readonly="1"/>
                        <field name="removed_total" readonly="1"/>
                        <field name="rollback_last_id" readonly="1"/>
                        <field name="project_count" readonly="1"/>

                    </group>

                    <group string="Resultado de la ultima reversion">

                        <field
                            name="rollback_log"
                            nolabel="1"
                            readonly="1"
                        />

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ACCION DEL HISTORIAL -->

    <record id="action_serviflow_ofipro_batches"
            model="ir.actions.act_window">

        <field name="name">Importaciones OfiPro</field>
        <field name="res_model">serviflow.ofipro.batch</field>
        <field name="view_mode">tree,form</field>

    </record>


    <!-- MENU DEL HISTORIAL -->

    <menuitem
        id="menu_serviflow_ofipro_batches"
        name="Historial importaciones OfiPro"
        parent="menu_serviflow_root"
        action="action_serviflow_ofipro_batches"
        sequence="41"
        groups="sb_hr_serviflow.group_serviflow_manager"
    />

</odoo>
