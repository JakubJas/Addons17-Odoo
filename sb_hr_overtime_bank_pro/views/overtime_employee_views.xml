<odoo>

    <record id="view_employee_overtime" model="ir.ui.view">
        <field name="name">hr.employee.overtime</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page
                    string="Overtime Bank"
                    groups="sb_hr_overtime_bank_pro.group_overtime_hr, sb_hr_overtime_bank_pro.group_overtime_admin"
                >

                    <group>

                        <button
                            name="%(action_create_overtime_entry)d"
                            type="action"
                            string="Nuevo"
                            context="{'default_employee_id': active_id}"
                            class="btn-primary"
                        />

                    </group>

                    <group string="Configuración del cálculo">

                        <group>

                            <field name="resource_calendar_id"
                                string="Horario de trabajo"
                                readonly="1"/>

                            <field name="overtime_current_mode"
                                string="Modalidad actual"
                                readonly="1"/>

                            <field name="overtime_balance"
                                string="Saldo banco de horas"
                                widget="float_time"
                                readonly="1"/>

                        </group>

                        <group>

                            <field name="overtime_new_mode"
                                string="Nueva modalidad"/>

                            <field name="overtime_change_date"
                                string="Aplicar desde"/>

                            <button name="action_apply_overtime_mode_change"
                                    string="Aplicar cambio"
                                    type="object"
                                    class="btn-primary"/>

                        </group>

                    </group>

                    <group string="Configuración de vacaciones">

                        <field name="vacation_weekday_ids"
                            string="Días que descuentan vacaciones"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>

                    </group>

                    <separator string="HISTORIAL DE MODALIDADES"/>

                    <field name="overtime_period_ids"
                        nolabel="1">

                        <tree editable="bottom">

                            <field name="date_from"
                                string="Desde"/>

                            <field name="date_to"
                                string="Hasta"/>

                            <field name="calculation_mode"
                                string="Modalidad"/>

                            <field name="weekly_expected_hours"
                                string="Horas semanales"
                                widget="float_time"
                                invisible="calculation_mode != 'weekly'"/>

                        </tree>

                    </field>

                    <group string="Mantenimiento">

                        <button
                            name="action_rebuild_overtime_history"
                            string="Reconstruir histórico automático"
                            type="object"
                            class="btn-secondary"
                            confirm="Se reconstruirán únicamente los movimientos automáticos de este empleado. Los movimientos manuales, pagos y compensaciones no se eliminarán. ¿Continuar?"
                        />

                    </group>

                    <separator string="MOVIMIENTOS OVERTIME"/>

                    <field
                        name="overtime_entry_ids"
                        groups="sb_hr_overtime_bank_pro.group_overtime_hr, sb_hr_overtime_bank_pro.group_overtime_admin"
                    >

                        <tree>

                            <field
                                name="date"
                                string="Fecha"
                            />

                            <field
                                name="type"
                                string="Tipo"
                            />

                            <field
                                name="signed_hours"
                                string="Horas"
                                widget="float_time"
                                sum="Total"
                            />

                            <field
                                name="reference"
                                string="Referencia"
                            />

                            <field
                                name="state"
                                string="Estado"
                            />

                        </tree>

                    </field>

                </page>

            </xpath>

        </field>

    </record>

</odoo>