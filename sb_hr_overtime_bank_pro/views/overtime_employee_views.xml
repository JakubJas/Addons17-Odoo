<odoo>

    <record id="view_employee_overtime" model="ir.ui.view">
        <field name="name">hr.employee.overtime</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page
                    string="Overtime Bank"
                    groups="sb_hr_overtime_bank_pro.group_overtime_hr, sb_hr_overtime_bank_pro.group_overtime_admin"
                >

                    <group>
                        <button
                            name="%(action_create_overtime_entry)d"
                            type="action"
                            string="Nuevo"
                            context="{'default_employee_id': active_id}"
                            class="btn-primary"
                        />
                    </group>

                    <group string="Configuración">
                        <field name="resource_calendar_id" readonly="1"/>
                        <field name="overtime_calculation_mode"/>
                        <field name="overtime_weekly_from" invisible="overtime_calculation_mode != 'weekly'"/>
                    </group>

                    <field
                        name="overtime_entry_ids"
                        groups="sb_hr_overtime_bank_pro.group_overtime_hr, sb_hr_overtime_bank_pro.group_overtime_admin"
                    >
                        <tree>
                            <field name="date" string="Fecha"/>
                            <field name="type" string="Tipo"/>
                            <field name="hours" string="Horas" widget="float_time"/>
                            <field name="reference" string="Referencia"/>
                            <field name="state" string="Estado"/>
                        </tree>
                    </field>

                </page>

            </xpath>

        </field>
    </record>

</odoo>