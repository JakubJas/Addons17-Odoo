<odoo>

    <!-- ===================================================== -->
    <!-- TREE                                                  -->
    <!-- ===================================================== -->

    <record id="view_hr_overtime_entry_tree" model="ir.ui.view">
        <field name="name">hr.overtime.entry.tree</field>
        <field name="model">hr.overtime.entry</field>

        <field name="arch" type="xml">

            <tree string="Overtime Entries">

                <field name="employee_id"
                       string="Empleado"/>

                <field name="date"
                       string="Fecha"/>

                <field name="type"
                       string="Tipo"/>

                <field name="signed_hours"
                       string="Horas"
                       widget="float_time"
                       sum="Total"/>

                <field name="state"
                       string="Estado"/>

                <field name="description"
                       string="Descripción"/>

                <!-- Auditoría -->
                <field name="expected_hours"
                       string="Previstas"
                       widget="float_time"
                       optional="hide"/>

                <field name="worked_hours"
                       string="Trabajadas"
                       widget="float_time"
                       optional="hide"/>

                <field name="difference_hours"
                       string="Diferencia"
                       widget="float_time"
                       optional="show"/>

                <!-- Compensación -->
                <field name="compensation_date"
                       string="Fecha disfrute"
                       optional="hide"/>

            </tree>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- FORM                                                  -->
    <!-- ===================================================== -->

    <record id="view_hr_overtime_entry_form" model="ir.ui.view">
        <field name="name">hr.overtime.entry.form</field>
        <field name="model">hr.overtime.entry</field>

        <field name="arch" type="xml">

            <form string="Overtime Entry">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <header>

                    <button name="action_confirm"
                            string="Confirmar"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_set_to_draft"
                            string="Volver a Borrador"
                            type="object"
                            invisible="state != 'done' or attendance_id"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,done"/>

                </header>


                <sheet>

                    <!-- ================================================= -->
                    <!-- DATOS PRINCIPALES                                 -->
                    <!-- ================================================= -->

                    <group>

                        <!-- COLUMNA IZQUIERDA -->
                        <group>

                            <field name="employee_id"
                                   string="Empleado"
                                   readonly="state == 'done'"/>

                            <field name="check_in"
                                   string="Entrada"
                                   readonly="state == 'done'"/>

                            <field name="check_out"
                                   string="Salida"
                                   readonly="state == 'done'"/>

                        </group>


                        <!-- COLUMNA DERECHA -->
                        <group>

                            <field name="hours"
                                   string="Horas"
                                   widget="float_time"
                                   readonly="state == 'done'"/>

                            <field name="type"
                                   string="Tipo"
                                   readonly="state == 'done'"/>

                            <field name="date"
                                   string="Fecha"
                                   readonly="state == 'done'"/>

                            <!--
                                Solo aparece para:
                                Compensar horas extras
                            -->
                            <field name="compensation_date"
                                   string="Fecha de disfrute"
                                   invisible="type != 'compensation'"
                                   readonly="state == 'done'"
                                   required="type == 'compensation'"/>

                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- CAMPOS TÉCNICOS                                   -->
                    <!-- ================================================= -->

                    <field name="attendance_id"
                           invisible="1"/>

                    <!-- Histórico / compatibilidad -->
                    <field name="leave_allocation_id"
                           invisible="1"/>

                    <!-- Nueva ausencia creada por compensación -->
                    <field name="compensation_leave_id"
                           invisible="1"/>


                    <!-- ================================================= -->
                    <!-- CÁLCULO AUTOMÁTICO                                -->
                    <!-- ================================================= -->

                    <group string="CÁLCULO AUTOMÁTICO"
                           invisible="reference not in ('Attendance overtime', 'Attendance overtime day', 'Attendance overtime week')">

                        <group>

                            <field name="expected_hours"
                                   string="Horas previstas"
                                   widget="float_time"
                                   readonly="1"/>

                            <field name="worked_hours"
                                   string="Horas trabajadas"
                                   widget="float_time"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="difference_hours"
                                   string="Diferencia de horas"
                                   widget="float_time"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- DETALLE SEMANAL                                   -->
                    <!-- ================================================= -->

                    <separator string="DETALLE SEMANAL"
                               invisible="reference != 'Attendance overtime week'"/>

                    <field name="attendance_ids"
                           nolabel="1"
                           readonly="1"
                           invisible="reference != 'Attendance overtime week'">

                        <tree create="0"
                              edit="0"
                              delete="0"
                              default_order="check_in asc">

                            <field name="attendance_local_date"
                                   string="Fecha"/>

                            <field name="attendance_local_check_in"
                                   string="Entrada"/>

                            <field name="attendance_local_check_out"
                                   string="Salida"/>

                            <field name="worked_hours"
                                   string="Horas trabajadas"
                                   widget="float_time"
                                   sum="Total trabajado"/>

                        </tree>

                    </field>


                    <!-- ================================================= -->
                    <!-- INFORMACIÓN                                       -->
                    <!-- ================================================= -->

                    <group string="INFORMACIÓN">

                        <field name="reference"
                               string="Referencia"
                               readonly="state == 'done'"/>

                        <field name="description"
                               string="Descripción"
                               readonly="state == 'done'"/>

                    </group>


                    <!-- ================================================= -->
                    <!-- ADJUNTO                                           -->
                    <!-- ================================================= -->

                    <group string="ADJUNTO">

                        <field name="attachment"
                               string="Documento"
                               filename="attachment_filename"
                               readonly="state == 'done'"/>

                        <field name="attachment_filename"
                               invisible="1"/>

                    </group>

                </sheet>


                <!-- ================================================= -->
                <!-- CHATTER                                           -->
                <!-- ================================================= -->

                <div class="oe_chatter">

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </div>

            </form>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- SEARCH                                                -->
    <!-- ===================================================== -->

    <record id="view_hr_overtime_entry_search" model="ir.ui.view">
        <field name="name">hr.overtime.entry.search</field>
        <field name="model">hr.overtime.entry</field>

        <field name="arch" type="xml">

            <search string="Search Overtime">

                <field name="employee_id"
                       string="Empleado"/>

                <field name="date"
                       string="Fecha"/>

                <field name="compensation_date"
                       string="Fecha de disfrute"/>

                <!-- ESTADOS -->

                <filter name="approved"
                        string="Aprobado"
                        domain="[('state','=','done')]"/>

                <filter name="pending"
                        string="Pendiente"
                        domain="[('state','=','draft')]"/>


                <!-- TIPOS -->

                <filter name="extra"
                        string="Horas extra"
                        domain="[('type','=','extra')]"/>

                <filter name="payment"
                        string="Pagadas"
                        domain="[('type','=','payment')]"/>

                <filter name="compensation"
                        string="Compensadas"
                        domain="[('type','=','compensation')]"/>


                <!-- AGRUPACIONES -->

                <group expand="0"
                       string="Group By">

                    <filter name="group_employee"
                            string="Empleado"
                            context="{'group_by':'employee_id'}"/>

                    <filter name="group_date"
                            string="Fecha"
                            context="{'group_by':'date'}"/>

                    <filter name="group_type"
                            string="Tipo"
                            context="{'group_by':'type'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- ACTION LIST                                           -->
    <!-- ===================================================== -->

    <record id="action_overtime_entries" model="ir.actions.act_window">
        <field name="name">Overtime Entries</field>
        <field name="res_model">hr.overtime.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hr_overtime_entry_search"/>
        <field name="context">{'group_by': 'employee_id'}</field>
    </record>


    <!-- ===================================================== -->
    <!-- ACTION NUEVO                                          -->
    <!-- ===================================================== -->

    <record id="action_create_overtime_entry" model="ir.actions.act_window">
        <field name="name">Nuevo registro de horas extra</field>
        <field name="res_model">hr.overtime.entry</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>