<odoo>

    <!-- ===================================================== -->
    <!-- CONFIGURACIÓN VACACIONES / DESCANSOS                  -->
    <!-- ===================================================== -->

    <record id="view_hr_vacation_config_form" model="ir.ui.view">

        <field name="name">hr.vacation.config.form</field>
        <field name="model">hr.vacation.config</field>

        <field name="arch" type="xml">

            <form string="Configuración de vacaciones y descansos">

                <sheet>

                    <group>

                        <field name="name"
                               readonly="1"/>

                    </group>


                    <!-- ============================================= -->
                    <!-- VACACIONES                                    -->
                    <!-- ============================================= -->

                    <separator string="VACACIONES"/>

                    <group>

                        <field name="leave_type_ids"
                               string="Tipos de vacaciones afectados"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>

                    </group>

                    <div class="alert alert-info"
                         role="alert">

                        Los tipos seleccionados aquí utilizarán
                        la configuración personalizada de días
                        del empleado:

                        <strong>
                            Lunes, Martes, Miércoles, Jueves,
                            Viernes, Sábado y Domingo.
                        </strong>

                    </div>


                    <!-- ============================================= -->
                    <!-- OVERTIME / DESCANSOS                          -->
                    <!-- ============================================= -->

                    <separator string="DESCANSO POR HORAS EXTRA"/>

                    <group>

                        <field name="compensation_leave_type_id"
                               string="Tipo para descanso por horas extra"
                               options="{'no_create': True, 'no_create_edit': True}"/>

                    </group>

                    <div class="alert alert-warning"
                         role="alert">

                        <strong>Importante:</strong>

                        este tipo se utilizará únicamente cuando
                        desde Overtime se seleccione

                        <strong>
                            “Disfrutar horas extra como descanso”.
                        </strong>

                        No debe requerir asignación previa ni utilizar
                        la deducción nativa de horas extra de Odoo.

                        El saldo válido será siempre el de
                        <strong>Overtime Bank</strong>.

                    </div>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- ACCIÓN                                                -->
    <!-- ===================================================== -->

    <record id="action_hr_vacation_config"
            model="ir.actions.act_window">

        <field name="name">Configuración vacaciones y descansos</field>
        <field name="res_model">hr.vacation.config</field>
        <field name="view_mode">form</field>

        <field name="res_id"
               ref="sb_hr_overtime_bank_pro.vacation_config_default"/>

        <field name="target">current</field>

    </record>


    <!-- ===================================================== -->
    <!-- MENÚ                                                  -->
    <!-- ===================================================== -->

    <menuitem id="menu_hr_vacation_config"
              name="Configuración vacaciones y descansos"
              parent="menu_overtime_root"
              action="action_hr_vacation_config"
              sequence="30"/>

</odoo>