<odoo>

    <record id="view_hr_vacation_config_form"
            model="ir.ui.view">

        <field name="name">hr.vacation.config.form</field>
        <field name="model">hr.vacation.config</field>

        <field name="arch" type="xml">

            <form string="Configuración de vacaciones y descansos">

                <sheet>

                    <group>

                        <field name="name"
                               readonly="1"/>

                        <field name="leave_type_ids"
                               string="Tipos de vacaciones afectados"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>

                        <field name="compensation_leave_type_id"
                               string="Tipo para descanso por horas extra"
                               options="{'no_create': True, 'no_create_edit': True}"/>

                    </group>

                    <div class="alert alert-info"
                         role="alert">

                        <strong>Importante:</strong>

                        el tipo usado para descanso por horas extra
                        no debe requerir asignación ni utilizar la
                        deducción nativa de horas extra de Odoo.

                        El saldo válido será únicamente el de
                        Overtime Bank.

                    </div>

                </sheet>

            </form>

        </field>

    </record>


    <record id="action_hr_vacation_config"
            model="ir.actions.act_window">

        <field name="name">
            Configuración vacaciones y descansos
        </field>

        <field name="res_model">hr.vacation.config</field>

        <field name="view_mode">form</field>

        <field name="res_id"
               ref="sb_hr_overtime_bank_pro.vacation_config_default"/>

        <field name="target">current</field>

    </record>


    <menuitem id="menu_hr_vacation_config"
              name="Configuración vacaciones y descansos"
              parent="menu_overtime_root"
              action="action_hr_vacation_config"
              sequence="30"/>

</odoo>